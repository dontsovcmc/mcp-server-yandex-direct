{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dontsovcmc/yandex-direct",
  "description": "MCP server for Yandex Direct API v5 — campaigns, ads, keywords, bids, audiences",
  "repository": {
    "url": "https://github.com/dontsovcmc/mcp-server-yandex-direct",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-server-yandex-direct",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "YD_TOKEN",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "YD_CLIENT_LOGIN",
          "isRequired": false
        },
        {
          "name": "YD_LANG",
          "isRequired": false
        },
        {
          "name": "YD_TIMEOUT",
          "isRequired": false
        },
        {
          "name": "YD_FILE_TIMEOUT",
          "isRequired": false
        }
      ]
    }
  ]
}
